{
  "name": "noteapp",
  "productName": "NoteApp",
  "version": "0.1.0",
  "description": "Простое приложение для визуальных заметок на досках",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "rcedit": "4.0.1"
  },
  "build": {
    "appId": "local.noteapp",
    "productName": "NoteApp",
    "files": ["main.js", "preload.js", "src/**/*", "assets/icon.ico", "assets/icon.png"],
    "afterPack": "scripts/afterPack.js",
    "win": { "target": "portable", "icon": "assets/icon.ico", "signAndEditExecutable": false }
  }
}
